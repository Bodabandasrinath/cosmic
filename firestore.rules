rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getCallDocData(callId) {
      return get(/databases/$(database)/documents/calls/$(callId)).data;
    }

    function isCallParticipant(callId) {
      return isAuthenticated() && (
        getCallDocData(callId).callerId == request.auth.uid ||
        getCallDocData(callId).receiverId == request.auth.uid ||
        (('participants' in getCallDocData(callId)) && (request.auth.uid in getCallDocData(callId).participants))
      );
    }
    
    // User Profiles
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && request.auth.uid == userId;
      allow delete: if isOwner(userId);
      
      // User Contacts subcollection
      match /contacts/{contactId} {
        allow read, write: if isOwner(userId);
      }
      
      // Blocked users subcollection
      match /blocked/{blockedId} {
        allow read, write: if isOwner(userId);
      }

      // User notifications subcollection
      match /notifications/{notificationId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Reports collection
    match /reports/{reportId} {
      allow create: if isAuthenticated() && request.resource.data.reporterId == request.auth.uid;
      allow read, update, delete: if false;
    }

    // Chats and Conversations
    match /chats/{chatId} {
      // Participant check: user must be in participants list
      allow read: if isAuthenticated() && (request.auth.uid in resource.data.participants);
      allow create: if isAuthenticated() && (request.auth.uid in request.resource.data.participants);
      allow update: if isAuthenticated() && (request.auth.uid in resource.data.participants);
      allow delete: if false;

      // Messages inside a chat
      match /messages/{messageId} {
        allow read: if isAuthenticated() && (
          resource.data.senderId == request.auth.uid || 
          resource.data.receiverId == request.auth.uid
        );
        allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid;
        allow update: if isAuthenticated() && (
          resource.data.senderId == request.auth.uid || 
          resource.data.receiverId == request.auth.uid // For read/delivery receipt update
        );
        allow delete: if isAuthenticated() && resource.data.senderId == request.auth.uid;
      }

      // Typing status inside chat
      match /typing/{userId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated() && request.auth.uid == userId;
      }
    }

    // WebRTC Direct Calling Signaling
    match /calls/{callId} {
      // Direct call: caller or receiver or participant only
      allow read: if isAuthenticated() && (
        resource.data.callerId == request.auth.uid || 
        resource.data.receiverId == request.auth.uid ||
        (('participants' in resource.data) && (request.auth.uid in resource.data.participants))
      );
      
      allow create: if isAuthenticated() && (
        request.resource.data.callerId == request.auth.uid ||
        (('participants' in request.resource.data) && (request.auth.uid in request.resource.data.participants))
      );
      
      allow update: if isAuthenticated() && (
        resource.data.callerId == request.auth.uid || 
        resource.data.receiverId == request.auth.uid ||
        (('participants' in resource.data) && (request.auth.uid in resource.data.participants))
      );
      
      allow delete: if isAuthenticated() && (
        resource.data.callerId == request.auth.uid || 
        resource.data.receiverId == request.auth.uid ||
        (('participants' in resource.data) && (request.auth.uid in resource.data.participants))
      );

      // Caller ICE Candidates
      match /callerCandidates/{candidateId} {
        allow read: if isCallParticipant(callId);
        allow create: if isAuthenticated() && (
          getCallDocData(callId).callerId == request.auth.uid ||
          (('participants' in getCallDocData(callId)) && (request.auth.uid in getCallDocData(callId).participants))
        );
        allow update, delete: if isCallParticipant(callId);
      }

      // Receiver ICE Candidates
      match /receiverCandidates/{candidateId} {
        allow read: if isCallParticipant(callId);
        allow create: if isAuthenticated() && (
          getCallDocData(callId).receiverId == request.auth.uid ||
          (('participants' in getCallDocData(callId)) && (request.auth.uid in getCallDocData(callId).participants))
        );
        allow update, delete: if isCallParticipant(callId);
      }
    }

    // Call History Logs
    match /call_logs/{userId}/logs/{logId} {
      allow read: if isOwner(userId);
      allow create: if isAuthenticated() && (
        isOwner(userId) || 
        request.resource.data.callerId == request.auth.uid ||
        request.resource.data.receiverId == request.auth.uid
      );
      allow update, delete: if isOwner(userId);
    }
  }
}
